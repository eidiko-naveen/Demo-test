```text
# ============================================================
# SECURITY - Credentials / Secrets
# C10 - No hardcoded credentials
# ============================================================

credentials/
credentials.json
token.json

.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Google / OAuth credentials
service-account*.json
client_secret*.json

# ============================================================
# Python cache
# ============================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

