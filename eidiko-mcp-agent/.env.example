# Eidiko Systems Integration - Environment Configuration Template

# Groq API Key (Main LLM Engine)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude API Key (Fallback LLM Engine)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Personal Access Token
GITHUB_TOKEN=your_github_token_here

# Model Configuration
LLM_MODEL=openai/gpt-oss-120b
FALLBACK_LLM_MODEL=claude-3-5-sonnet-20241022

# MCP Remote SSE Server Endpoints (Hybrid Architecture)
GITHUB_SSE_URL=http://localhost:8001/sse
EMAIL_SSE_URL=http://localhost:8002/sse
SEARCH_SSE_URL=http://localhost:8003/sse
