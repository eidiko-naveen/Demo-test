# Eidiko Systems Integration - Environment Configuration Template

# Anthropic Claude API Key (Primary LLM Engine)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key (Fallback LLM Engine)
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
LLM_MODEL=claude-3-5-sonnet-20241022
FALLBACK_LLM_MODEL=openai/gpt-oss-120b

# MCP Remote SSE Server Endpoints (Hybrid Architecture)
GITHUB_SSE_URL=http://localhost:8001/sse
EMAIL_SSE_URL=http://localhost:8002/sse
SEARCH_SSE_URL=http://localhost:8003/sse
