# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Primary model requested by this project
LLM_MODEL=openai/gpt-oss-120b

# Optional Groq fallback if the primary model is unavailable
FALLBACK_LLM_MODEL=llama-3.1-8b-instant

# GitHub Personal Access Token used by the official GitHub MCP server
GITHUB_TOKEN=your_github_personal_access_token_here
