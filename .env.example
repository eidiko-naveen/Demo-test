# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║          OCP AI Monitoring Agent — Environment Configuration               ║
# ║  Copy this file to .env and fill in your actual values.                    ║
# ║  NEVER commit .env to version control.                                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Temperature=0 for deterministic JSON outputs in analysis chains
LLM_TEMPERATURE=0
# Max tokens for analysis response (failures JSON can be large)
LLM_MAX_TOKENS=4096

# ── OpenShift Cluster ─────────────────────────────────────────────────────────
# For in-cluster deployment, leave these blank — agent auto-detects ServiceAccount
# For local/external testing, provide path to kubeconfig
KUBECONFIG_PATH=
# Override the context name if needed (leave blank for current-context)
OCP_CONTEXT=
# Cluster display name shown in reports and dashboard
CLUSTER_NAME=SB-PROD-OCP
REQUIRE_OPENSHIFT=true
# Optional Docker DNS compatibility mapping for a private OpenShift API.
# Leave the Compose defaults unchanged or set these to your API hostname/IP.
OCP_API_HOSTNAME=api.ocp.eidikointernal.com
OCP_API_HOST_IP=192.168.1.169

# ── PostgreSQL Database ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres-svc
POSTGRES_PORT=5432
# Host port used by pgAdmin when PostgreSQL runs through Docker Compose.
POSTGRES_PUBLISHED_PORT=5437
POSTGRES_DB=ocp_monitor
POSTGRES_USER=ocp_agent
POSTGRES_PASSWORD=
# Full DSN is constructed from above; or override directly:
# DATABASE_URL=postgresql+psycopg2://ocp_agent:password@postgres-svc:5432/ocp_monitor

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Choose one: smtp or sendgrid
EMAIL_BACKEND=smtp

## SMTP settings (used when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

## SendGrid settings (used when EMAIL_BACKEND=sendgrid)
SENDGRID_API_KEY=

## Common email settings
EMAIL_FROM=ocp-monitor@company.com
# JSON array of recipient addresses
EMAIL_TO=["ops-team@company.com", "platform-admin@company.com"]
# Master switch for all email delivery
EMAIL_ENABLED=false
# Send email even when cluster is healthy (set false to only alert on failures)
EMAIL_ON_HEALTHY=true
# Do not alert for connectivity/unsupported-API errors alone
EMAIL_ON_COLLECTION_ERROR=false

# ── Scheduler ─────────────────────────────────────────────────────────────────
INTERVAL_MINUTES=15
TIMEZONE=Asia/Kolkata
SCHEDULER_HEALTH_FILE=/tmp/ocp-monitor/heartbeat
HEALTHCHECK_MAX_AGE_SECONDS=1800

# ── Health Check Thresholds ───────────────────────────────────────────────────
# CPU/Memory % threshold — alert if any node exceeds this
NODE_CPU_THRESHOLD=80
NODE_MEMORY_THRESHOLD=80
# TLS cert expiry warning window (days)
CERT_EXPIRY_WARNING_DAYS=30

# ── CP4I Specific ─────────────────────────────────────────────────────────────
# Namespaces to monitor for failing pods (comma-separated)
MONITORED_NAMESPACES=openshift-etcd,openshift-kube-apiserver,openshift-kube-controller-manager,openshift-kube-scheduler,openshift-ingress,openshift-storage,cp4i,ibm-common-services,cms,eidiko-chatbot

# CP4I API endpoints to health-check (comma-separated URLs)
CP4I_HEALTH_ENDPOINTS=
# Set false on clusters without the CP4I PlatformNavigator API.
CP4I_PLATFORM_NAVIGATOR_ENABLED=true

# ── LlamaIndex RAG ────────────────────────────────────────────────────────────
# Embeddings model for indexing historical incidents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Top-K similar incidents to retrieve
RAG_TOP_K=3

# ── Google Meet auto-escalation ────────────────────────────────────────────────
# Keep disabled until you have generated credentials for your own Google account.
ESCALATION_ENABLED=false
# Match against failure component, resource name, and pod namespace.
ESCALATION_COMPONENTS=cp4i
ESCALATION_CONSECUTIVE_CYCLES=2
ESCALATION_OWNERS_FILE=agent/escalation_owners.json
ESCALATION_FALLBACK_OWNERS=["ops-oncall@company.com"]
ESCALATION_MEETING_DURATION_MINUTES=30

# Enable Google Calendar API and create a Desktop OAuth client, then run:
#   python get_google_refresh_token.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Human-approved remediation ────────────────────────────────────────────────
# Start in dry-run mode. Live execution additionally requires an approval secret
# and narrowly scoped OpenShift RBAC.
HITL_ENABLED=true
HITL_EXECUTION_ENABLED=false
HITL_ALLOWED_NAMESPACE=eidiko-chatbot
HITL_ALLOWED_DEPLOYMENT=bankingchatbot
HITL_APPROVER_EMAIL=yash.eidiko@gmail.com
HITL_DASHBOARD_URL=http://localhost:8502
HITL_APPROVAL_SECRET=
HITL_POLL_SECONDS=30
HITL_ROLLOUT_TIMEOUT_SECONDS=180

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
# How many past runs to show on dashboard
DASHBOARD_HISTORY_LIMIT=20

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Format: json (for log aggregators like Splunk/ELK) or console (human-readable)
LOG_FORMAT=json
