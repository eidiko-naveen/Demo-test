# Development-safe defaults. Put real secrets in an untracked .env or secret manager.
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-key
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# SQLite is for local development only; use PostgreSQL in production.
DATABASE_URL=sqlite:///./storage/chatbot.db

# Use either local QDRANT_PATH (development) or authenticated QDRANT_URL (production).
QDRANT_PATH=./qdrant_storage
QDRANT_URL=
QDRANT_API_KEY=replace-with-qdrant-key
QDRANT_COLLECTION=enterprise_rag

DATA_DIR=./data
AUTH_MODE=development
DEV_USER_ID=development-user
DEV_TENANT_ID=development-tenant

TOP_K=5
RELEVANCE_THRESHOLD=0.35
CHUNK_SIZE=800
CHUNK_OVERLAP=120

MAX_HISTORY_MESSAGES=50
MEMORY_WINDOW_SIZE=6
MEMORY_CONTEXT_CHARS=12000
SUMMARY_TRIGGER_MESSAGES=12
UPLOAD_MAX_SIZE_MB=25
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_SIZE_MB=100
MAX_EXTRACTED_CHARS=2000000
MAX_ARCHIVE_MEMBERS=2000
MAX_ARCHIVE_UNCOMPRESSED_MB=100
MAX_QUESTION_CHARS=8000
MAX_CONCURRENT_REQUESTS=8
EXTERNAL_SEARCH_PROVIDER=

# Disabled by default. Never enable content capture for sensitive workloads.
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Required by docker-compose.production.yml only.
POSTGRES_DB=rag_chatbot
POSTGRES_USER=rag_chatbot
POSTGRES_PASSWORD=replace-with-a-long-random-password